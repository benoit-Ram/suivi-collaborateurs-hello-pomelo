# Backend env vars — en prod, injectées par Infisical au runtime du container
# En dev local, copier ce fichier vers backend/.env et remplir les valeurs

# PostgreSQL — connection string au format standard pg
# En dev avec docker compose : DATABASE_URL=postgres://hp:hp_dev_password@db:5432/suivi_collaborateurs
# En prod : fournie par la Managed DB (Digital Ocean / OVH) via Infisical
DATABASE_URL=postgres://hp:hp_dev_password@localhost:5432/suivi_collaborateurs

# SSL — activé par défaut (Managed DB). Désactiver en dev local avec `false`.
DB_SSL=false

# Pool pg — taille max connexions (<= limite plan DB, Basic 1GB = 22 max)
DB_POOL_MAX=10

# Logger queries SQL (debug uniquement)
DB_LOG_QUERIES=false

# Auth
GOOGLE_CLIENT_ID=<client id OAuth Google>
JWT_SECRET=<secret long aléatoire, ne jamais commiter>

# CORS — liste séparée par virgules des origines frontend autorisées
FRONTEND_URL=http://localhost:3000,https://rh.pomelo-dev.fr

# URL publique pour liens dans les mails
APP_URL=https://rh.pomelo-dev.fr

# Google Workspace integration (optionnel)
GOOGLE_MAIL_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_IMPERSONATE_DEFAULT=benoit@hello-pomelo.com
GOOGLE_MAIL_FROM=no-reply@hello-pomelo.com
GOOGLE_SERVICE_ACCOUNT_KEY=<JSON stringifié de la clé du service account>

# Serveur
PORT=4000
NODE_ENV=development
